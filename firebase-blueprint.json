{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the SatyaAPI platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "FactCheck": {
      "title": "FactCheck",
      "description": "A fact-check verdict generated by the system.",
      "type": "object",
      "properties": {
        "post_id": { "type": "string" },
        "claim": { "type": "string" },
        "original_text": { "type": "string" },
        "verdict": { "type": "string", "enum": ["TRUE", "FALSE", "MISLEADING", "UNVERIFIABLE", "ERROR"] },
        "confidence": { "type": "number" },
        "reason": { "type": "string" },
        "supporting_fact_id": { "type": "string" },
        "model_used": { "type": "string" },
        "embedding_model": { "type": "string" },
        "compression_ratio": { "type": "number" },
        "processing_time_ms": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "language": { "type": "string" },
        "authorUid": { "type": "string" }
      },
      "required": ["claim", "verdict", "confidence", "reason"]
    },
    "RawNews": {
      "title": "RawNews",
      "description": "Raw news articles fetched from Google News RSS.",
      "type": "object",
      "properties": {
        "article_id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "url": { "type": "string" },
        "source": { "type": "string" },
        "published": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "claims_extracted": { "type": "boolean" },
        "processed_at": { "type": "string", "format": "date-time" }
      },
      "required": ["article_id", "title", "url"]
    },
    "LiveFact": {
      "title": "LiveFact",
      "description": "Verified facts extracted from news or manually added.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "category": { "type": "string", "enum": ["government", "health", "economy", "sports", "other"] },
        "source_url": { "type": "string" },
        "article_title": { "type": "string" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "added_at": { "type": "string", "format": "date-time" },
        "indexed": { "type": "boolean" },
        "indexed_at": { "type": "string", "format": "date-time" },
        "times_matched": { "type": "number" },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "text", "category"]
    }
    "UserHistory": {
      "title": "UserHistory",
      "description": "A record of a fact-check performed by the user.",
      "type": "object",
      "properties": {
        "post_id": { "type": "string" },
        "claim": { "type": "string" },
        "verdict": { "type": "string", "enum": ["TRUE", "FALSE", "MISLEADING", "UNVERIFIABLE", "ERROR"] },
        "confidence": { "type": "number" },
        "reason": { "type": "string" },
        "model_used": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["claim", "verdict"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "A log of user actions for auditing purposes.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "keyName": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/users/{userId}/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit logs for the user."
    },
    "/fact_checks/{factCheckId}": {
      "schema": "FactCheck",
      "description": "Fact check verdicts."
    },
    "/raw_news/{articleId}": {
      "schema": "RawNews",
      "description": "Raw news articles."
    },
    "/live_facts/{factId}": {
      "schema": "LiveFact",
      "description": "Verified facts database."
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "UserHistory",
      "description": "User's personal fact-check history."
    }
  }
}
